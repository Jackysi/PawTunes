{
    "name": "jackysi/pawtunes",
    "description": "PawTunes - Open Source Radio Player",
    "type": "project",
    "license": "MPL-2.0",
    "require": {
        "php": ">=8.1",
        "scssphp/scssphp": "^2.1"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    },
    "autoload": {
        "psr-4": {
            "lib\\": "inc/lib/",
            "API\\": "panel/lib/API/"
        },
        "classmap": [
            "panel/lib/BladeOne.php",
            "panel/lib/Forms.php",
            "panel/lib/Panel.php"
        ]
    }
}
